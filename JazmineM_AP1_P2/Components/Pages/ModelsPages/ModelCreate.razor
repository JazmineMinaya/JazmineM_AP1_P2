@page "/Models/Create"
@rendermode InteractiveServer

@inject ModelsService modelsService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Crear Model</PageTitle>

@* Picker para el detalle *@
<div class="border border-success p-3 mt-3">
    <h5>Detalles</h5>

    <div class="input-group">
        <span class="input-group-text">Seleccione:</span>

        <InputSelect class="form-select" @bind-Value="EntityPicker">
            <option value="0">
                -- Seleccione un elemento --
            </option>

            @foreach (var model in ListaModels)
            {
                <option value="@model.ModelId">
                    @model.ModelId
                </option>
            }
        </InputSelect>

        <span class="input-group-text">Cantidad:</span>
        <InputNumber class="form-control" @bind-Value="Cantidad" />

        <button type="button" class="btn btn-outline-success" @onclick="AgregarModel">
            + Agregar
        </button>
    </div>
</div>

@code {
    public List<Model> ListaModels { get; set; } = new();

    public int EntityPicker { get; set; }
    public int Cantidad { get; set; } = 1;

    private void AgregarModel()
    {
        throw new NotImplementedException();
    }
}
